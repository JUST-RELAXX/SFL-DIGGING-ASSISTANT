{
  "manifest_version": 3,
  "name": "SFL Digging Assistant",
  "version": "1.0.0",
  "description": "Desert digging overlay with grid themes, live dig tracking, treasure stats and formation solver.",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.sunflower-land.com/*",
    "https://sunflower-land.com/play/*",
    "https://sfl.world/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Open SFL Digging Assistant",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sunflower-land.com/play/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css",
        "grid-themes.css",
        "custom-engine.css",
        "panels.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "bridge.js",
        "digging-solver.js",
        "sand_shovel.png",
        "sand_drill.png",
        "ITEMS/Cheer.webp",
        "ITEMS/camel_bone.webp",
        "ITEMS/clam_shell.webp",
        "ITEMS/clover_coin.webp",
        "ITEMS/cockle_shell.webp",
        "ITEMS/coins.webp",
        "ITEMS/coral.png",
        "ITEMS/crab.png",
        "ITEMS/flower.webp",
        "ITEMS/happy.png",
        "ITEMS/hieroglyph.webp",
        "ITEMS/old_bottle.png",
        "ITEMS/otter_pebble.webp",
        "ITEMS/pearl.webp",
        "ITEMS/pipi.webp",
        "ITEMS/pirate_bounty.webp",
        "ITEMS/pirate_cake.webp",
        "ITEMS/prize_ticket.png",
        "ITEMS/radish_cake.png",
        "ITEMS/rare_key.png",
        "ITEMS/salt_dino_egg.webp",
        "ITEMS/sand.webp",
        "ITEMS/sand_drill.png",
        "ITEMS/sand_shovel.png",
        "ITEMS/sea_cucumber.png",
        "ITEMS/seaweed.webp",
        "ITEMS/shroom_syrup.png",
        "ITEMS/starfish.png",
        "ITEMS/stone.png",
        "ITEMS/stopwatch.png",
        "ITEMS/treasure_key.png",
        "ITEMS/vase.webp",
        "ITEMS/wheat_cake.png",
        "ITEMS/wood.png",
        "ITEMS/wooden_compass.webp"
      ],
      "matches": [
        "https://sunflower-land.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "114"
}
