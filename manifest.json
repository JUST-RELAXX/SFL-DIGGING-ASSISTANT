{
  "manifest_version": 3,
  "name": "SFL Game Assistant",
  "version": "12.1",
  "description": "Digging grid overlay with 30 premium themes, custom theme builder, auto-alignment and live dig tracking.",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.sunflower-land.com/*",
    "https://sunflower-land.com/play/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open SFL Digging Helper"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://sunflower-land.com/play/*"],
      "js": ["content.js"],
      "css": ["overlay.css", "grid-themes.css", "custom-engine.css"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["bridge.js"],
      "matches": ["https://sunflower-land.com/*"]
    }
  ]
}
