{
  "manifest_version": 3,
  "name": "Sunflower Land Game Assistant",
  "version": "12.0",
  "description": "A comprehensive game assistant for Sunflower Land — deliveries, digging grid, farm stats & more.",
  "permissions": ["sidePanel", "activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://sunflower-land.com/*",
    "https://*.sunflower-land.com/*",
    "https://api.sunflower-land.com/*",
    "https://sfl.world/*",
    "https://api.coingecko.com/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "SFL Game Assistant"
  },
  "icons": {
    "48": "images/tokens/sfl.webp",
    "128": "images/tokens/sfl.webp"
  },
  "content_scripts": [
    {
      "matches": ["https://sunflower-land.com/*", "https://*.sunflower-land.com/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["bridge.js", "images/*"],
      "matches": ["https://sunflower-land.com/*", "https://*.sunflower-land.com/*"]
    }
  ]
}