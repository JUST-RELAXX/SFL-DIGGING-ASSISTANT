{
  "manifest_version": 3,
  "name": "SFL Digging Assistant",
  "version": "1.0.0",
  "description": "Desert digging overlay with grid themes, live dig tracking, treasure stats and formation solver.",
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.sunflower-land.com/*",
    "https://sunflower-land.com/play/*",
    "https://sfl.world/*"
  ],
  "icons": {
    "16": "sand_shovel.png",
    "48": "sand_shovel.png",
    "128": "sand_shovel.png"
  },
  "action": {
    "default_title": "Open SFL Digging Assistant",
    "default_icon": {
      "16": "sand_shovel.png",
      "48": "sand_shovel.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sunflower-land.com/play/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css",
        "grid-themes.css",
        "custom-engine.css",
        "panels.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "bridge.js",
        "digging-solver.js",
        "ITEMS/*",
        "sand_shovel.png",
        "sand_drill.png"
      ],
      "matches": [
        "https://sunflower-land.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "114"
}
